{
  "schemaVersion": 1,
  "id": "blockbuster",
  "version": "${version}",
  "name": "Blockbuster",
  "description": "Design, direct and act in your own Minecraft machinimas — full port of Blockbuster 1.12.2 with bundled McLib, Metamorph, Aperture and Chameleon.",
  "authors": [
    "McHorse (original Blockbuster, McLib, Metamorph, Aperture, Chameleon)",
    "Blockbuster 1.21.1 full-port project"
  ],
  "contact": {
    "sources": "https://github.com/mchorse/blockbuster",
    "homepage": "https://github.com/mchorse/blockbuster"
  },
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": ["mchorse.blockbuster.Blockbuster"],
    "client": ["mchorse.blockbuster.BlockbusterClient"]
  },
  "mixins": [
    "blockbuster.mixins.json",
    {"config": "blockbuster.client.mixins.json", "environment": "client"},
    "metamorph.mixins.json",
    {"config": "metamorph.client.mixins.json", "environment": "client"},
    {"config": "blockbuster.iris.mixins.json", "environment": "client"}
  ],
  "accessWidener": "blockbuster.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "emoticons": "*"
  }
}
